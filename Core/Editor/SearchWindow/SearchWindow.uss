/* SearchWindow. Colors that differ by editor skin come from Unity's own theme variables. */

/* Header: search field, then one tab per section when there are several. */

.search-window .search-window__search {
    width: auto;
    flex-shrink: 0;
    margin-left: 3px;
    margin-right: 2px;
}

.search-window .search-window__tab-bar {
    flex-shrink: 0;
}

.search-window .search-window__tab {
    flex-grow: 1;
}

/* Thin bar along the bottom of a tab while its section builds; the width is set from code. */
.search-window .search-window__tab-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    background-color: rgb(77, 179, 255);
}

/* The controls: the title, the search field and the tabs. A drop-down hangs them from the top of its own window, so the old and the new
   ones of a pick made in steps can fade past each other. */

.search-window .search-window__controls {
    flex-shrink: 0;
}

.search-window--drop-down .search-window__controls {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
}

/* A drop-down's list, a window of its own against the controls': no edge of its own on that side, the controls' edge between them.
   Its content hangs from its top, as tall as its rows. Each rule sets the room the root keeps for an edge and the edge drawn in it. */

.search-window.search-window--drop-down.search-window--list-frame {
    border-top-width: 0;
}

.search-window.search-window--drop-down.search-window--list-frame > .search-window__edge {
    top: 0;
    border-top-width: 0;
}

.search-window.search-window--drop-down.search-window--list-frame.search-window--above {
    border-top-width: 1px;
    border-bottom-width: 0;
}

.search-window.search-window--drop-down.search-window--list-frame.search-window--above > .search-window__edge {
    top: -1px;
    bottom: 0;
    border-top-width: 1px;
    border-bottom-width: 0;
}

/* Without a title, a search field or tabs, the controls' window is cut away and the list's window draws its edge all round. */

.search-window.search-window--drop-down.search-window--list-frame.search-window--no-controls {
    border-top-width: 1px;
}

.search-window.search-window--drop-down.search-window--list-frame.search-window--no-controls > .search-window__edge {
    top: -1px;
    border-top-width: 1px;
}

.search-window.search-window--drop-down.search-window--list-frame.search-window--no-controls.search-window--above {
    border-bottom-width: 1px;
}

.search-window.search-window--drop-down.search-window--list-frame.search-window--no-controls.search-window--above > .search-window__edge {
    bottom: -1px;
    border-bottom-width: 1px;
}

/* Where windows cannot be cut, the controls' window without controls stays a line, the drop-down's edge on its side alone. */

.search-window.search-window--drop-down.search-window--edge-only {
    border-bottom-width: 0;
}

.search-window.search-window--drop-down.search-window--edge-only > .search-window__edge {
    bottom: 0;
    border-bottom-width: 0;
}

.search-window.search-window--drop-down.search-window--edge-only.search-window--above {
    border-top-width: 0;
    border-bottom-width: 1px;
}

.search-window.search-window--drop-down.search-window--edge-only.search-window--above > .search-window__edge {
    top: 0;
    bottom: -1px;
    border-top-width: 0;
    border-bottom-width: 1px;
}

.search-window--list-frame .search-window__content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    flex-grow: 0;
}

/* Above its button, a drop-down turns over: the search field and the tabs next to the button, the breadcrumb and the first row next to them. */

.search-window--above .search-window__controls,
.search-window--above .search-window__page {
    flex-direction: column-reverse;
}

/* As specific as the header's own rule below plus one class, so it wins over it wherever the two sit in the file. */
.search-window.search-window--above .search-window__header {
    border-bottom-width: 0;
    border-top-width: 1px;
}

/* Body: the progress bar while building, otherwise the current page. */

.search-window .search-window__content {
    flex-grow: 1;
    overflow: hidden;
    justify-content: center;
}

.search-window .search-window__build-progress {
    margin-left: 20px;
    margin-right: 20px;
}

/* A page fills the body so the old and the new one can slide past each other. */
.search-window .search-window__page {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Centered while it fits: the auto margins share the spare room. When it does not, they drop to 0, the row starts at
   the left and the label is cut with an ellipsis. */
.search-window .search-window__breadcrumb {
    height: 22px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgba(77, 77, 77, 0.3);
}

.search-window .search-window__breadcrumb:hover {
    background-color: rgba(102, 102, 102, 0.4);
}

.search-window .search-window__breadcrumb-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: auto;
}

.search-window .search-window__breadcrumb-label {
    flex-shrink: 1;
    min-width: 0;
    margin-right: auto;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.search-window .search-window__list {
    flex-grow: 1;
}

/* A drop-down has no window frame of its own, so it draws its edge; its corners round where its windows are cut (BorderlessWindow).
   The root keeps the room and the edge, its last child, draws there, over the content: a row lit at the top or the bottom then lies
   under the edge's curve, where UI Toolkit draws an element's own border under its children. */

.search-window.search-window--drop-down {
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.search-window.search-window--drop-down > .search-window__edge {
    position: absolute;
    left: -1px;
    right: -1px;
    top: -1px;
    bottom: -1px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
}

/* The title of a drop-down, which has no title bar to carry it. */

.search-window .search-window__header {
    -unity-font-style: bold;
    flex-shrink: 0;
    white-space: normal;
    padding: 3px 6px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-color: var(--unity-colors-toolbar-border);
}

/* Rows: icon, label, and an arrow when the row opens a deeper level. */

/* As far in from the left as the breadcrumb, with or without an icon. */
.search-window .search-window__row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding-left: 4px;
}

.search-window .search-window__row--selected {
    background-color: var(--unity-colors-highlight-background);
}

/* A row that cannot be picked, its reason beside its label. */
.search-window .search-window__row--disabled .search-window__row-icon,
.search-window .search-window__row--disabled .search-window__row-label {
    opacity: 0.45;
}

.search-window .search-window__row-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 2px;
}

.search-window .search-window__row-label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    -unity-text-align: middle-left;
    margin-left: 0;
    padding-left: 0;
}

.search-window .search-window__row-arrow {
    width: 14px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* A choice's button at the row's end, such as Install; full strength on a grayed-out row, as it is what the row offers. */
.search-window .search-window__row-action {
    flex-shrink: 0;
    height: 16px;
    margin: 0 4px 0 2px;
    padding: 0 6px;
}